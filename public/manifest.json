{
  "manifest_version": 3,
  "name": "Plume RSS Reader",
  "version": "1.0.0",
  "description": "A clean, privacy-first RSS reader. No account required.",

  "permissions": ["storage", "alarms", "tabs"],
  "host_permissions": ["<all_urls>"],

  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js",
    "type": "module"
  },

  "action": {
    "default_title": "Open Plume RSS Reader",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "96": "icons/icon96.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "plume@safar.dev",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
